# Supabase (Vercel + local dev)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Maricopa Assessor. The comp backfill joins public ArcGIS bulk downloads (no
# key). This token is only for the live API used by on-demand parcel checks
# (/api/parcel/{apn}) — request one via the "API Question/Token" option on
# https://www.mcassessor.maricopa.gov/contact/
MARICOPA_API_TOKEN=

# Resend. DIGEST_FROM_EMAIL must be an address on a domain verified in Resend
# (resend.com/domains) to send to arbitrary recipients. The onboarding@resend.dev
# fallback only reaches your own Resend account email.
RESEND_API_KEY=
DIGEST_TO_EMAIL=anthony@antrealestateco.com
DIGEST_FROM_EMAIL="Deal Checker <onboarding@resend.dev>"

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# No Clozers credentials needed — the Spencer's List feed and the internal API
# backing it (api.clozers.co/v1/spencers-deals) are both public, no login required.

# --- Tunable placeholders (see src/lib/config.ts) — all optional, defaults shown ---
# REHAB_PER_SQFT=25
# MARGIN_THRESHOLD=0.20
# BELOW_AVG_THRESHOLD=0.12
# MIN_SUBDIVISION_COMPS=3
# ASSESSOR_LOOKBACK_MONTHS=12   # also update supabase/migrations views to match
# CLOZERS_ACTIVE_WINDOW_DAYS=10
# CLOZERS_MIN_BEDS=2
# CLOZERS_POSTED_WITHIN_DAYS=7
